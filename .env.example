# Copy to .env and adjust. docker-compose.yml already supplies working defaults for
# local development, so .env is optional until later phases add secrets.
# Never commit .env.

# --- api ---
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Service names resolve inside the compose network. rs0 is required for transactions.
MONGO_URL=mongodb://mongo:27017/happynails?replicaSet=rs0
REDIS_URL=redis://redis:6379
# CORS allow-list: the only browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# --- web / admin (dev server) ---
# Where Vite proxies /api. Set by docker-compose.yml; only needed when running Vite elsewhere.
# API_PROXY_TARGET=http://api:4000

# --- host port overrides (docker-compose.yml) ---
# Only change these if something else on your machine already uses a port.
# Containers always talk to each other on the standard ports.
# API_HOST_PORT=4000
# WEB_HOST_PORT=5173
# ADMIN_HOST_PORT=5174
# MONGO_HOST_PORT=27017
# REDIS_HOST_PORT=6379

# --- Razorpay (api only; never exposed to the browser except the key id) ---
# Use test-mode keys locally (rzp_test_...). Set all three or none; with none, only cash on delivery is offered.
# Dashboard > Account & Settings > API Keys, and > Webhooks for the webhook secret.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

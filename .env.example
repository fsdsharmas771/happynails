# Copy to .env and adjust. docker-compose.yml already supplies working defaults for
# local development, so .env is optional until later phases add secrets.
# Never commit .env.

# --- api ---
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Service names resolve inside the compose network. rs0 is required for transactions.
MONGO_URL=mongodb://mongo:27017/happynails?replicaSet=rs0
REDIS_URL=redis://redis:6379
# CORS allow-list: the only browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# --- web / admin (dev server) ---
# Where Vite proxies /api. Set by docker-compose.yml; only needed when running Vite elsewhere.
# API_PROXY_TARGET=http://api:4000

# --- host port overrides (docker-compose.yml) ---
# Only change these if something else on your machine already uses a port.
# Containers always talk to each other on the standard ports.
# API_HOST_PORT=4000
# WEB_HOST_PORT=5173
# ADMIN_HOST_PORT=5174
# MONGO_HOST_PORT=27017
# REDIS_HOST_PORT=6379

# --- Razorpay (api only; never exposed to the browser except the key id) ---
# Use test-mode keys locally (rzp_test_...). Set all three or none; with none, checkout cannot take payment.
# Dashboard > Account & Settings > API Keys, and > Webhooks for the webhook secret.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- admin (api) ---
# Signs admin session cookies. At least 32 random characters; never reuse across environments.
# ADMIN_JWT_SECRET=
# The seed creates the first owner from these if no owner exists yet. Change the password after first login.
# ADMIN_OWNER_EMAIL=
# ADMIN_OWNER_PASSWORD=
# Where uploaded images and videos are stored (local disk provider). Defaults to ./uploads in the api container.
# UPLOAD_DIR=/app/uploads

# --- public site ---
# The storefront's public address (no trailing slash). Used for the sitemap, canonical links
# and structured data. PLACEHOLDER: the domain has not been chosen yet; leave unset until it is.
# PUBLIC_SITE_URL=https://www.example.in

# --- WhatsApp (Meta Cloud API) ---
# From Meta for Developers > your app > WhatsApp > API setup. Use a permanent System User token.
# Without these, customer messages are logged instead of sent. Templates: see README.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Shiprocket ---
# Create an API user in Shiprocket (Settings > API > Configure). Pickup location = the exact name
# of your pickup address in Shiprocket. Without these, the Ship with Shiprocket button is hidden.
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_PICKUP_LOCATION=Primary
# Any long random string; enter the same as the token for the tracking webhook in Shiprocket
# (Settings > API > Webhooks), with the URL https://<your-domain>/api/webhooks/courier-tracking
# SHIPROCKET_WEBHOOK_TOKEN=

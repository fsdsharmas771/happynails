{
  "name": "@happynails/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backfill:invoices": "tsx src/scripts/backfill-invoices.ts"
  },
  "dependencies": {
    "@happynails/shared": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "mongoose": "8.24.4",
    "multer": "2.4.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "razorpay": "2.9.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "nodemon": "3.1.14",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "3.2.7"
  }
}
